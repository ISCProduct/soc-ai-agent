# Application Environment (development/staging/production)
# staging/production のみ企業取得などのエラー JSON を S3 (error-logs/) へ保存する
APP_ENV=development

# Database Configuration
DB_USER=app_user
DB_PASSWORD=app_pass
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_db

# Server Configuration
SERVER_PORT=8080
ADMIN_SECRET=change-me-admin-secret
USER_SECRET=change-me-user-secret
# OAuth CSRF 対策用シークレット（ADMIN_SECRET とは独立して設定すること）（#407）
# 生成例: python3 -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=change-me-oauth-state-secret
# CORS 許可オリジン（カンマ区切り）（#327: 未設定時は全オリジン拒否）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis（#617: レート制限共有・永続ジョブキュー asynq）
# 未設定時はインメモリ制限 + go func フォールバック
# ローカル compose: redis://localhost:6379/0  /  compose 内 Backend: redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# Email（#756: Resend 推奨。SMTP は段階移行用）
# EMAIL_PROVIDER=resend|smtp|log （未設定時は RESEND_API_KEY → SMTP_HOST → log の順で自動選択）
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@shukatsu-ai.jp
# Resend（https://resend.com）— ドメイン shukatsu-ai.jp を Verified にする（#758）
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=就活AI <noreply@shukatsu-ai.jp>
# プラン stub（#810）。未設定時は pro。#612 後は未契約を free に。
# DEFAULT_PLAN=pro
# 従来 SMTP（互換・フォールバック）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# GitHubアクセストークン暗号化キー（AES-256-GCM）（#326）
# 生成例: python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Realtime interview cost controls
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=120
INTERVIEW_COST_PER_MIN_USD=0.18
REALTIME_MAX_CONCURRENT_CONNECTIONS=30
REALTIME_MONTHLY_ALERT_THRESHOLD_USD=200
# REALTIME_ALERT_EMAILS=ops@example.com,admin@example.com
# REALTIME_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# MATCHING_ALERT_EMAILS=ops@example.com,admin@example.com

# OpenAI API 全体の月次コストアラート（api_call_logs 集計 / UTC 月境界）#604
OPENAI_COST_ALERT_THRESHOLD_USD=40
# OPENAI_COST_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# OPENAI_COST_ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# ※ Slack 未設定時は REALTIME_ALERT_SLACK_WEBHOOK_URL へフォールバック

# RAG Service (rag-review コンテナ)
# ローカル: docker compose --profile rag up -d
RAG_REVIEW_URL=http://localhost:9000
# Backend→RAG の内部認証トークン (#615)。両サービスで同一の値を設定する
# 未設定の場合 RAG はヘルスチェック以外の全リクエストを拒否する（フェイルクローズ）
# 本番は `openssl rand -hex 32` などで生成した値を設定すること
RAG_INTERNAL_TOKEN=dev-internal-token
# Phase 1B (#557): Read 経路の企業 Search は既定オフ。admin 温存・再埋め込み時のみ true
RAG_ALLOW_WEB_SEARCH_FALLBACK=false
RAG_USE_DEEP_RESEARCH=false
# L1 カタログ温存バッチ（1実行あたり上限。日次クロール warm_l1_catalog でも使用）
L1_WARM_BATCH_LIMIT=100
# マッチング理由の AI 生成（既定オフ。テンプレ+DBのみ）#588
# MATCHING_REASON_USE_AI=true
# Chroma（compose profile=rag）
CHROMA_HOST=localhost
CHROMA_PORT=8000
# 企業別面接傾向ヒットの web search に使用するモデル
# Responses API の web_search + gpt-4o-mini（search-preview / gpt-5-search-api は使わない）
OPENAI_HINTS_MODEL=gpt-4o-mini
# ヒットの JSON 構造化抽出に使用するモデル
OPENAI_HINTS_PARSE_MODEL=gpt-4o

# Go WebSearchJSON / RAG web search（Responses API web_search + mini）
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini

# 企業情報取得パイプライン専用（#557）
# スクレイプ/gBiz/Search結果 → JSON 抽出（高頻度・低コスト）
OPENAI_COMPANY_EXTRACT_MODEL=gpt-4o-mini
# Responses API の web_search。gpt-5-search-api / search-preview は使わない
OPENAI_COMPANY_SEARCH_MODEL=gpt-4o-mini
# ※ 企業情報パイプラインでは未使用（コスト回避）。将来の手動フォールバック用に残置
# OPENAI_COMPANY_DEEP_SEARCH_MODEL=gpt-4o-mini
# Search 結果の構造化（2段目）
OPENAI_COMPANY_PARSE_MODEL=gpt-4o-mini
# 長文（有報・IR）からの関係抽出など高精度 Parse（必要時のみ）
OPENAI_COMPANY_PARSE_MODEL_ADVANCED=gpt-4o

# 企業 Search Provider（#590）openai | brave
COMPANY_SEARCH_PROVIDER=openai
# Brave 利用時（COMPANY_SEARCH_PROVIDER=brave）
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# 企業 FirstTouch Search 予算ガード（#587 / #633 Phase 3）
COMPANY_SEARCH_MONTHLY_LIMIT=2000
COMPANY_SEARCH_BUDGET_ENFORCE=true
COMPANY_SEARCH_ALERT_THRESHOLD=2000
# COMPANY_SEARCH_ALERT_EMAILS=ops@example.com
# COMPANY_SEARCH_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# COMPANY_SEARCH_ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# （未設定時は OPENAI_COST_ALERT_DISCORD_WEBHOOK_URL へフォールバック可）

# Base URL (for OAuth callbacks)
BASE_URL=http://localhost:8080
APP_URL=http://localhost:3000
COMPANY_GRAPH_THRESHOLD=0.75
DEFAULT_SCHOOL_NAME=学校法人岩崎学園情報科学専門学校
GUEST_EMAIL_DOMAIN=temp.local

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
