# ============================================================
# ローカル統合テスト専用 .env のテンプレート（compose.test.yml が使う）
#
# 使い方:
#   cp Backend/.env.test.example Backend/.env.test
# （.env.test は .gitignore 対象。個人の Backend/.env とは完全に別ファイル）
#
# ここに書く DB_HOST/DB_PORT は「ホストから直接 go run する場合」の値。
# docker compose 経由で動く app コンテナ側は compose.test.yml の
# environment: で DB_HOST=db / DB_PORT=3306 に上書きされる（コンテナ内
# ネットワークのため）。詳しい事情は compose.test.yml のコメント参照。
#
# 詳細手順: docs/wiki/getting-started.md 「ローカル統合テスト環境」節
# ============================================================
APP_ENV=development

# db サービスは compose.test.yml で別ポート(既定 13306)・別コンテナ名で
# 起動する。個人の dev 用 MySQL とはデータ・ポートともに完全に分離される。
#
# MYSQL_* は mysql:8.0 イメージが初回起動時にユーザー/DBを作るための変数
# （DB_USER/DB_PASSWORD/DB_NAME とは別名でも必要。ここが無いと、
# compose.test.yml の env_file !override が効いていても個人devの
# Backend/.env の値で初期化されてしまい、DB_USER/DB_PASSWORD で
# アプリから繋げなくなる。実機検証で発覚済み）。
MYSQL_ROOT_PASSWORD=e2e-test-root-password
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass
MYSQL_DATABASE=app_db

DB_USER=app_user
DB_PASSWORD=app_pass
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=app_db

SERVER_PORT=8080

# 個人の dev 用 .env とは必ず別値にする（本番シークレットの流用禁止。
# ここはローカル専用テスト環境なので固定の分かりやすい値で構わない）。
ADMIN_SECRET=e2e-test-admin-secret
SERVICE_SECRET=e2e-test-service-secret
USER_SECRET=e2e-test-user-secret
COMPANY_USER_SECRET=e2e-test-company-user-secret
# 未設定だと起動時に Fatal になる（本番/開発共通の必須チェック）
OAUTH_STATE_SECRET=e2e-test-oauth-state-secret

ALLOWED_ORIGINS=http://localhost:13000,http://127.0.0.1:13000

# AI呼び出しはOpenAIの実コストをかけない（PRD/DesignDoc参照）。
# ローカルに互換エンドポイント（Ollama等）が無い場合は、該当機能を使う
# smoke テストを追加するまでは起動エラーにならない範囲でそのままにしてよい。
AI_TEXT_PROVIDER=local
AI_TEXT_BASE_URL=http://localhost:11434/v1
