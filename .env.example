# Docker Compose環境変数
# このファイルをコピーして .env を作成してください: cp .env.example .env

# フロントエンド設定
FRONTEND_DOCKERFILE=Dockerfile.dev
NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
BACKEND_URL=http://app:8080

# バックエンド設定
DOCKERFILE=Dockerfile
HOST_PORT=8080
ADMIN_SECRET=change-me-admin-secret
USER_SECRET=change-me-user-secret
COMPANY_USER_SECRET=change-me-company-user-secret
# OAuth CSRF 対策用シークレット（ADMIN_SECRET とは独立して設定すること）（#407）
# 生成例: python3 -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=change-me-oauth-state-secret

# データベース設定
DB_HOST_BIND=127.0.0.1

# OpenAI API キー (必須)
OPENAI_API_KEY=your-openai-api-key-here

# RAG設定
# 企業別面接傾向ヒットの web search に使用するモデル
# Responses API の web_search + gpt-4o-mini（search-preview / gpt-5-search-api は使わない）
# 注: rag/main.py は現状 OPENAI_WEB_SEARCH_MODEL を参照（OPENAI_HINTS_MODEL は未使用）
OPENAI_HINTS_MODEL=gpt-4o-mini
# ヒットの JSON 構造化抽出に使用するモデル（search モデルは json_object 非対応のため分離）
OPENAI_HINTS_PARSE_MODEL=gpt-4o
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
RAG_HINTS_PARSE_MAX_TOKENS=600
RAG_REVIEW_RESUME_CHAR_LIMIT=10000
RAG_CHROMA_DATA_DIR=/app/chroma_db

# 企業情報取得パイプライン（#557）— 実装 Phase 1 で Backend が参照
OPENAI_COMPANY_EXTRACT_MODEL=gpt-4o-mini
OPENAI_COMPANY_SEARCH_MODEL=gpt-4o-mini
OPENAI_COMPANY_DEEP_SEARCH_MODEL=gpt-4o-mini
OPENAI_COMPANY_PARSE_MODEL=gpt-4o-mini
OPENAI_COMPANY_PARSE_MODEL_ADVANCED=gpt-4o

# ログ設定
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# gBizINFO APIトークン (https://info.gbiz.go.jp/common/accesstoken/ から取得)
GBIZINFO_API_TOKEN=your-gbizinfo-api-token-here

# ボリューム設定
DB_VOLUME_TYPE=mysql_data
MYSQL_CONF_DIR=./mysql/conf.d
