# Docker Compose環境変数
# このファイルをコピーして .env を作成してください: cp .env.example .env

# フロントエンド設定
FRONTEND_DOCKERFILE=Dockerfile.dev
NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
BACKEND_URL=http://app:8080

# バックエンド設定
DOCKERFILE=Dockerfile
HOST_PORT=8080
ADMIN_SECRET=change-me-admin-secret
USER_SECRET=change-me-user-secret
COMPANY_USER_SECRET=change-me-company-user-secret
# OAuth CSRF 対策用シークレット（ADMIN_SECRET とは独立して設定すること）（#407）
# 生成例: python3 -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=change-me-oauth-state-secret

# データベース設定
DB_HOST_BIND=127.0.0.1

# OpenAI API キー (必須)
OPENAI_API_KEY=your-openai-api-key-here

# ── AI プロバイダ切り替え (#1293) ─────────────────────────────────────────
# テキスト生成 / 埋め込み / 音声(STT・TTS) の3系統を、それぞれ独立に
# OpenAI 互換の推論先へ向けられる。すべて未設定なら従来どおり OpenAI を使う。
#
# OPENAI_API_KEY が未設定でもサーバーは起動する。OpenAI を使う系統だけが縮退し、
# AI を使わない機能（企業検索・企業一覧・マッチング・選考管理・求人）は動作する。
#
# provider に local を指定した場合は base URL が必須（未設定なら起動時にエラー）。
# 埋め込み・音声は provider を省略するとテキストの provider を継承する。
# base URL は「継承元と provider が同じとき」だけ継承するため、
# 1台に全部載せる構成やゲートウェイ経由なら AI_TEXT_* の指定だけでよい。
# 系統ごとに分けたい場合（例: テキストはローカル、埋め込みは OpenAI）は
# その系統の PROVIDER を明示する（明示した系統は base URL を継承しない）。
# 実キー(OPENAI_API_KEY)を送るのは provider=openai かつ「本家宛、または base URL を
# 明示指定した場合（プロキシ・互換ゲートウェイ）」だけ。provider=local と、
# 継承した base URL へはダミー値 "local" を送る。
# ローカル推論先へ向けるときは必ず provider=local を指定すること
# （provider=openai のまま base URL だけローカルにすると実キーが送られる）。
#
# 例: Ollama を1台で使う
#   AI_TEXT_PROVIDER=local
#   AI_TEXT_BASE_URL=http://localhost:11434/v1
#   AI_TEXT_MODEL=gpt-oss-20b
#
# AI_TEXT_PROVIDER=openai
# AI_TEXT_BASE_URL=
# AI_TEXT_MODEL=
# AI_EMBEDDING_PROVIDER=
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_MODEL=
# AI_AUDIO_PROVIDER=
# AI_AUDIO_BASE_URL=

# ── OpenAI へのフォールバックと Hard Limit (#1293) ───────────────────────────
# ローカル推論先が落ちたときに OpenAI へ再試行する。障害が続く間ずっと全トラフィックが
# 従量課金へ移ると高額請求になるため、日次/月次のUSD上限と分間レートで打ち切る。
# 上限に達したらフォールバックをやめて縮退する（サービス全体は止めない）。
#
# 対象は「ローカル推論先を使っている系統」だけ。OpenAI 本家を使っている系統や
# 実キーが無い場合はフォールバック自体を組まない。4xx は再試行しない
# （リクエスト自体の問題は OpenAI でも失敗するため）。
#
# OPENAI_FALLBACK_ENABLED=true          # false で完全に無効化
# OPENAI_DAILY_HARD_LIMIT_USD=2         # 0 で無制限
# OPENAI_MONTHLY_HARD_LIMIT_USD=20      # 0 で無制限
# OPENAI_FALLBACK_MAX_REQUESTS_PER_MINUTE=  # 未設定/0 で無制限
# AI_FALLBACK_PROVIDER=openai           # openai 以外を指定するとフォールバックしない
# AI_FALLBACK_BASE_URL=                 # 既定は https://api.openai.com/v1

# RAG設定
# 企業別面接傾向ヒットの web search に使用するモデル
# Responses API の web_search + gpt-4o-mini（search-preview / gpt-5-search-api は使わない）
# 注: rag/main.py は現状 OPENAI_WEB_SEARCH_MODEL を参照（OPENAI_HINTS_MODEL は未使用）
OPENAI_HINTS_MODEL=gpt-4o-mini
# ヒットの JSON 構造化抽出に使用するモデル（search モデルは json_object 非対応のため分離）
OPENAI_HINTS_PARSE_MODEL=gpt-4o
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
RAG_HINTS_PARSE_MAX_TOKENS=600
RAG_REVIEW_RESUME_CHAR_LIMIT=10000
RAG_CHROMA_DATA_DIR=/app/chroma_db

# 企業情報取得パイプライン（#557）— 実装 Phase 1 で Backend が参照
OPENAI_COMPANY_EXTRACT_MODEL=gpt-4o-mini
OPENAI_COMPANY_SEARCH_MODEL=gpt-4o-mini
OPENAI_COMPANY_DEEP_SEARCH_MODEL=gpt-4o-mini
OPENAI_COMPANY_PARSE_MODEL=gpt-4o-mini
OPENAI_COMPANY_PARSE_MODEL_ADVANCED=gpt-4o

# ログ設定
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# gBizINFO APIトークン (https://info.gbiz.go.jp/common/accesstoken/ から取得)
GBIZINFO_API_TOKEN=your-gbizinfo-api-token-here

# ボリューム設定
DB_VOLUME_TYPE=mysql_data
MYSQL_CONF_DIR=./mysql/conf.d
