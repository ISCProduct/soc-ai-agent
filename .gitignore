# ============================================================
# 環境変数・シークレット
# ============================================================
.env
.env.local
.env.production
.env.*.local
.backlog.env

# Terraform（シークレットを含む可能性があるため管理外）
*.tfvars
*.tfvars.json
backend.hcl
.terraform/
.terraform.lock.hcl
*.plan
stg.plan
*.tfstate
*.tfstate.backup
*.tfplan

# ============================================================
# 生成物・キャッシュ
# ============================================================
# ビルド成果物
bin/
dist/
build/
/Backend/server
Backend/server.pid

# 一時ファイル
tmp/
temp/
*.tmp
*.log
logs/

# 依存・ツールチェーンのローカルキャッシュ
/frontend/node_modules
/frontend/.next
/frontend/next-env.d.ts
/frontend/tsconfig.tsbuildinfo
/frontend/.swc
rag/.venv/
__pycache__/
*.pyc
.pytest_cache/
.tools/

# Playwright の実行結果（生成物）。追跡すると毎回差分が出る
frontend/test-results/

# next dev が自動生成するエージェント指示ファイル。
# 生成物であり、各PRの差分に毎回混入するため追跡しない（#1074 レビュー指摘）。
frontend/AGENTS.md
frontend/CLAUDE.md

# リポジトリ内に作られるエージェント用 worktree（実体は git worktree）。
# 追跡・検索・IDEインデックスの対象外にする。
.claude/worktrees/

# ============================================================
# データベース
# ============================================================
# 旧ローカル bind mount 用ディレクトリ（現在は named volume mysql_data を使用）
database/
mysql/logs/
*.sql
*.sqlite
# マイグレーションファイルはバージョン管理対象 (#614)
!Backend/migrations/*.sql

# ============================================================
# OS / IDE
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# 追跡しないローカルドキュメント・作業メモ
# ============================================================
/DOCKER_QUICK_START.md
/DOCKER_README.md
/DOCKER_SECURITY.md
/DOCKER_SETUP.md
/Backend/CURL_EXAMPLES.md
/Backend/README_CHAT_API.md
/Backend/README_RESUME_REVIEW.md
/Backend/test_api.sh

# 各セッションの作業メモ
/tasks/

# 調査・検証用のディレクトリ。音声などの大きなファイルや
# 生データ、他セッション向けの作業指示が入るため追跡しない。
# 設計の正本のうち docs/wiki / docs/design / docs/requirements は追跡対象。
#
# ただし RESULTS_*.md は例外として追跡する。
# 設計書・要件定義書がこれらを判断の根拠として参照しており
# （例: interview-voice-architecture.md → RESULTS_fallback.md）、
# 追跡から外すとリンク先が存在しなくなる。
docs/research/**
!docs/research/**/
!docs/research/**/RESULTS_*.md

# アーキテクチャ図・インフラ構成メモ（draw.io / PNG / 環境依存ドキュメント）
docs/architecture/
