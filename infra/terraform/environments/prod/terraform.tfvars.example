region       = "ap-northeast-1"
project_name = "soc-app"
vpc_cidr     = "10.20.0.0/16"

db_instance_class = "db.t4g.micro"
db_name           = "app_db"

domain_name = "shukatsu-ai.jp"

# 既存 ECR のイメージ（本番タグを指定）
backend_image  = "ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/soc-backend:latest"
frontend_image = "ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/soc-frontend:latest"

# --- シークレット ---
# 本番の実シークレットはここに書かない(#1158)。値は Secrets Manager を正とし、
# Terraform は入れ物だけを管理する。更新手順は docs/wiki/prod-secrets-rotation.md。
#
# 【新規環境の初期構築】先に値を入れて一度だけ apply する。
# ここを飛ばして下の secret_values_managed_outside = true だけを付けると、
# 空文字が Secrets Manager に書き込まれ、起動はするが OpenAI 依存の機能が
# 全部 401 で死ぬ(precondition も素通りする)。
# openai_api_key       = "sk-xxxx"
# resend_api_key       = "re_xxxx"
# google_client_secret = "xxxx"
# github_client_secret = "xxxx"

# 【apply 後 / 既存環境】値をこのファイルから消し、次を有効にする。
# これが無いと openai_api_key が空であることを precondition が弾く。
# secret_values_managed_outside = true
#
# admin_secret は指定しない(未指定なら本番専用の値が自動生成される)。
# staging と同じ値を入れないこと。

# 別管理の OpenAI キーを参照する場合の ARN
# openai_secret_arn = "arn:aws:secretsmanager:ap-northeast-1:ACCOUNT_ID:secret:prod/openai/api-key-xxxxxx"

# 可能なら社内/VPN CIDR に制限する
# allowed_http_cidrs = ["x.x.x.x/32"]

# --- 起動/停止（既定は停止 = 0。Fargateなので稼働時間分のみ課金） ---
# 本番反映・展示などで起動する場合のみ 1 以上にして apply する
# backend_desired_count  = 1
# frontend_desired_count = 1

# タスクサイズ（Fargateの有効な組み合わせに従うこと）
# backend_cpu    = 256
# backend_memory = 512
# frontend_cpu    = 256
# frontend_memory = 512
