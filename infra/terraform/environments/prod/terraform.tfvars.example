region        = "ap-northeast-1"
project_name  = "soc-app"
vpc_cidr      = "10.20.0.0/16"
instance_type = "t4g.small"

db_instance_class = "db.t4g.micro"
db_name            = "app_db"

domain_name = "shukatsu-ai.jp"

# 既存 ECR のイメージ（本番タグを指定）
backend_image  = "ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/soc-backend:latest"
frontend_image = "ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/soc-frontend:latest"

# 本番用 OpenAI キーの Secrets Manager ARN
# openai_secret_arn = "arn:aws:secretsmanager:ap-northeast-1:ACCOUNT_ID:secret:prod/openai/api-key-xxxxxx"

# 可能なら社内/VPN CIDR に制限する
# allowed_http_cidrs = ["x.x.x.x/32"]

# --- 起動/停止（既定は停止 = 0） ---
# 本番反映・展示などで起動する場合のみ 1 以上にして apply する
# ecs_desired_capacity = 1
# ecs_min_size         = 1
