region       = "ap-northeast-1"
project_name = "soc-app"
vpc_cidr     = "10.20.0.0/16"

db_instance_class = "db.t4g.micro"
db_name           = "app_db"

domain_name = "shukatsu-ai.jp"

# 同一アカウントでは staging が作った ECR を参照（manage_ecr=false が既定）
# image_tag = "latest"
# 別アカウントで ECR も作る場合のみ:
# manage_ecr = true

# 明示上書きする場合のみ:
# backend_image  = "508897596159.dkr.ecr.ap-northeast-1.amazonaws.com/soc-backend:latest"
# frontend_image = "508897596159.dkr.ecr.ap-northeast-1.amazonaws.com/soc-frontend:latest"

# openai_secret_arn = "arn:aws:secretsmanager:ap-northeast-1:508897596159:secret:prod/openai/api-key-xxxxxx"

# backend_desired_count  = 1
# frontend_desired_count = 1
