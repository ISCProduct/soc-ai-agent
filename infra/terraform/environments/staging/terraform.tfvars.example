region            = "ap-northeast-1"
project_name      = "soc-stg"
vpc_cidr          = "10.10.0.0/16"
instance_type     = "t4g.small"
db_instance_class = "db.t4g.micro"
db_name           = "app_db"

domain_name = "shukatsu-ai.jp"
# 既定: stg.shukatsu-ai.jp（FE） / api-stg.shukatsu-ai.jp（BE）

# ECR は Terraform が作成。イメージ URI は未指定なら自動（…/soc-backend:staging）
# image_tag = "staging"
# 明示上書きする場合のみ:
# backend_image  = "508897596159.dkr.ecr.ap-northeast-1.amazonaws.com/soc-backend:staging"
# frontend_image = "508897596159.dkr.ecr.ap-northeast-1.amazonaws.com/soc-frontend:staging"

# OpenAI（未設定でも apply 可。AI 機能だけ動かない）
# openai_secret_arn = "arn:aws:secretsmanager:ap-northeast-1:508897596159:secret:stg/openai/api-key-xxxxxx"

# allowed_http_cidrs = ["x.x.x.x/32"]
# enable_ssh = true
# allowed_ssh_cidrs = ["x.x.x.x/32"]
