#!/bin/bash
set -eux

# --- Docker + Compose plugin ---
apt-get update -y
apt-get install -y ca-certificates curl gnupg unzip jq
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# --- AWS CLI（認証情報はインスタンスプロファイル経由のIAMロールを使用。#829） ---
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
mkdir -p /root/.aws
cat > /root/.aws/config <<EOF
[default]
region = ${aws_region}
EOF

aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin "$(echo ${backend_image} | cut -d/ -f1)"

mkdir -p /opt/app/nginx/static
cat > /opt/app/nginx/staging-edge.conf <<'NGINXEOF'
${edge_nginx_conf}
NGINXEOF
cat > /opt/app/nginx/static/service-unavailable.html <<'HTMLEOF'
${service_unavailable_html}
HTMLEOF
cat > /opt/app/nginx/static/service-starting.html <<'HTMLEOF'
${service_starting_html}
HTMLEOF

mkdir -p /opt/app

# --- シークレットの取得(#1158) ---
# user_data は launch template のバージョンとして保存され、
# ec2:DescribeLaunchTemplateVersions を持つIAMユーザーなら誰でも読めるうえ、
# インスタンス上からは IMDS 経由でも読める。したがってシークレットは
# user_data に載せず、インスタンスロールで起動時に Secrets Manager から取得し、
# 0600 の .env にだけ書く。
#
# 取得の前にトレース(set -x)を止める。止めないと値が
# /var/log/cloud-init-output.log に平文で残る。
set +x
app_secrets=$(aws secretsmanager get-secret-value --region ${aws_region} \
  --secret-id "${app_env_secret_id}" --query SecretString --output text)
db_password=$(aws secretsmanager get-secret-value --region ${aws_region} \
  --secret-id "${db_secret_id}" --query SecretString --output text | jq -r '.password')
# 取得に失敗したらここで止める。空の値で .env を書くと、起動はするのに
# 認証やDB接続だけが通らない状態で動き出し、原因特定に時間がかかる。
test -n "$app_secrets"
test -n "$db_password" && test "$db_password" != null
set -x

# 先に 0600 の空ファイルを作る。中身を書いてから chmod すると、
# その一瞬だけ 0644 で他ユーザーにシークレットが読める。
install -m 600 /dev/null /opt/app/.env

cat >> /opt/app/.env <<EOF
SERVER_PORT=8080
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
APP_ENV=staging
AWS_REGION=${aws_region}
AWS_S3_BUCKET=${s3_bucket}
S3_BUCKET=${s3_bucket}
GBIZINFO_BASE_URL=${gbizinfo_base_url}
OPENAI_MODEL=${openai_model}
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
OPENAI_COMPANY_SEARCH_MODEL=gpt-4o-mini
OPENAI_HINTS_MODEL=gpt-4o-mini
# AI面接のSTT。既定は gpt-transcribe。mini にすると問題発話だけ
# gpt-transcribe へ自動で再送する(stt_fallback.go)。
OPENAI_WHISPER_MODEL=${openai_whisper_model}
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@shukatsu-ai.jp
GOOGLE_CLIENT_ID=${google_client_id}
GITHUB_CLIENT_ID=${github_client_id}
DISCORD_PUBLIC_KEY=${discord_public_key}
DISCORD_ALLOWED_ROLE_ID=${discord_allowed_role_id}
GITHUB_DISPATCH_REPO=${github_dispatch_repo}
BASE_URL=https://${backend_domain}
APP_URL=https://${frontend_domain}
ALLOWED_ORIGINS=https://${frontend_domain}
NEXT_PUBLIC_BACKEND_URL=https://${backend_domain}
BACKEND_URL=https://${backend_domain}
# X-Forwarded-For のどこが実クライアントIPかは frontend の手前の段数で決まる(#1407)。
# staging は常に ALB -> edge nginx -> frontend の2段。
# edge nginx へは ALB の SG からしか届かないため、この2段は迂回できない。
# CloudFront(error_fallback)は S3 エラーページ専用の失敗時経路なので段数に数えない。
TRUSTED_PROXY_HOPS=${trusted_proxy_hops}
RAG_REVIEW_URL=http://rag-review:9000
CHROMA_HOST=chroma
CHROMA_PORT=8000
SERVER_PORT=8080
REDIS_URL=redis://redis:6379/0
EOF

# シークレット行を追記する。どのキーが入るかは main.tf の
# aws_secretsmanager_secret_version.app_env（キー名は env 変数名の小文字）を見る。
# BFF_INTERNAL_TOKEN は staging 全インスタンスで同一でなければならないため、
# ここで生成せず Secrets Manager の値をそのまま使う(#1407)。
# SENTRY_DSN が空なら Backend/RAG は Sentry を初期化しない(#1185)。
set +x
{
  printf '%s' "$app_secrets" | jq -r 'to_entries[] | "\(.key | ascii_upcase)=\(.value)"'
  printf 'DB_PASSWORD=%s\n' "$db_password"
} >> /opt/app/.env
set -x

cat > /opt/app/docker-compose.yml <<EOF
x-logging: &default-logging
  driver: awslogs
  options:
    awslogs-region: "${aws_region}"
    awslogs-group: "${log_group_name}"
    # ストリーム名をコンテナ名にする。既定は FullID で、どのサービスのログか読めない。
    tag: "{{.Name}}"
    # awslogs でも docker logs が読めるようローカルキャッシュを残す(Dockerのdual logging)。
    # 上限を切らないとディスクが埋まる。
    cache-max-size: "10m"
    cache-max-file: "3"

services:
  backend:
    image: ${backend_image}
    restart: always
    env_file: .env
    logging: *default-logging
    ports:
      - "8080:8080"
    depends_on:
      - rag-review
      - redis
  frontend:
    image: ${frontend_image}
    restart: always
    env_file: .env
    logging: *default-logging
    expose:
      - "3000"
  edge:
    image: nginx:1.27-alpine
    restart: always
    logging: *default-logging
    ports:
      - "3000:80"
    volumes:
      - ./nginx/staging-edge.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/static:/usr/share/nginx/html/static:ro
    depends_on:
      - frontend
  rag-review:
    image: ${rag_image}
    restart: always
    env_file: .env
    logging: *default-logging
    depends_on:
      - chroma
  chroma:
    image: chromadb/chroma:0.6.3
    restart: always
    logging: *default-logging
    volumes:
      - chroma_data:/chroma/chroma
    environment:
      IS_PERSISTENT: "TRUE"
      ANONYMIZED_TELEMETRY: "FALSE"
  redis:
    image: redis:7-alpine
    restart: always
    logging: *default-logging

volumes:
  chroma_data:
EOF

cd /opt/app
docker compose up -d
