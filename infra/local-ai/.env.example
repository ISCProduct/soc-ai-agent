# 推論 PC（Ubuntu 8GB・GPU なし）向け。このディレクトリの Compose 専用。
# Backend（別マシン）からは VPN / トンネル等でプライベート到達できる経路が必要。
# 接続先の渡し方は docs/wiki/ai-failover.md とリポジトリ直下の .env.example を参照。

# --- 公開バインド ---
# 認証なし API のため既定は loopback。VPN 側のアドレスだけに絞るときはここに書く。
# Docker の ports 公開はホストの ufw を迂回するので、0.0.0.0 にしないこと。
LOCAL_AI_BIND=127.0.0.1

# --- 公開ポート（ホスト側） ---
LOCAL_AI_STT_PORT=8080
LOCAL_AI_LLM_PORT=11434
LOCAL_AI_TTS_PORT=50021

# --- Whisper.cpp ---
# tiny（既定・省メモリ） / base（精度寄り・メモリ増）
WHISPER_MODEL=tiny
# スレッド数。未指定ならコンテナ内の既定
# WHISPER_THREADS=4

# --- Ollama ---
# 8GB では 1.7b がギリギリ。OOM したら 0.6b に落とす（実機未検証）。
OLLAMA_MODEL=qwen3:1.7b
# OLLAMA_MODEL=qwen3:0.6b
# モデルをメモリに残す（-1 で無期限）。縮退のコールドスタート回避。
OLLAMA_KEEP_ALIVE=-1

# --- VOICEVOX ---
# Backend の AI_FAILOVER_LOCAL_TTS_SPEAKER と揃える（既定 1）
VOICEVOX_SPEAKER=1

# --- スクリプトが叩く URL（省略時は LOCAL_AI_BIND + 各ポート） ---
# LOCAL_AI_STT_URL=http://127.0.0.1:8080
# LOCAL_AI_LLM_URL=http://127.0.0.1:11434
# LOCAL_AI_TTS_URL=http://127.0.0.1:50021

# --- Backend に渡す接続先の例 ---
# 本番 Backend は Fargate のため、推論 PC の LAN IP だけでは届かない。
# VPN・SSM ポートフォワード・PrivateLink 等で Backend → 推論 PC を結んだうえで渡す。
# AI_FAILOVER_LOCAL_STT_URL=http://10.0.0.5:8080
# AI_FAILOVER_LOCAL_LLM_URL=http://10.0.0.5:11434/v1
# AI_FAILOVER_LOCAL_LLM_MODEL=qwen3:1.7b
# AI_FAILOVER_LOCAL_TTS_URL=http://10.0.0.5:50021
# AI_FAILOVER_LOCAL_TTS_SPEAKER=1
